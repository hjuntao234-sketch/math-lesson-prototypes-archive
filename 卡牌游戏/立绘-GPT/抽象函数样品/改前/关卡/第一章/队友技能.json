    "探": {"名": "认型", "说": "看看它是哪一类见过的题。"},
    "出手": {"名": "换个样子"},
    "验": {"名": "变回去", "挡": ["式", "根", "条件"], "说": "我把你的结果变回去，对了一遍——"}
  },
  "数形结合": {
    "探": {"名": "草图", "说": "我先画个草图！"},
    "出手": {"名": "画出来"},
    "验": {"名": "对图", "挡": ["段", "序", "端"], "说": "你看，和图对不上——"}
  },
  "特殊化": {
    "探": {"名": "代个数", "类": "代个数", "说": "我来代！你说代几？"},
    "出手": {"名": "举个数"},
    "验": {"名": "抽查", "挡": ["段", "驳", "根"], "说": "我先抽了一个数查——"}
  },
  "构造": {
    "探": {"名": "找缺口", "说": "……缺哪一块。"},
    "出手": {"名": "补全"},
    "验": {"名": "展开对一遍", "挡": ["式"], "说": "……展开，对不上。"}
  },
  "整体代换": {
    "探": {"名": "找整体", "说": "有没有反复出现的一坨？打包！"},
    "出手": {"名": "打包"},
    "验": {"名": "拆包代回", "挡": ["换元"], "说": "拆开代回去看看！"}
  },
  "退化与边界": {
    "探": {"名": "看边上", "说": "……先看边上。"},
    "出手": {"名": "守边"},
