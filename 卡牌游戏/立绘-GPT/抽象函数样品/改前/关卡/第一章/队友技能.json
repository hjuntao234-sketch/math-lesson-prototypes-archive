  },
  "分类讨论": {
    "探": {"名": "找分界", "说": "看它在哪儿变脸。"},
    "出手": {"名": "分路"},
    "验": {"名": "对账", "挡": ["分类"], "说": "分开走，回来对账——"}
  },
  "方程思想": {
    "探": {"名": "数未知", "说": "先把两边摆平：几个未知，几个条件？"},
    "出手": {"名": "列方程"},
    "验": {"名": "代回每个条件", "挡": ["根", "方程"], "说": "每个条件都代回去称一称——"}
  }
}
